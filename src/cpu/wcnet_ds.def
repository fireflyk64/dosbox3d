/*
 *  Data-segment map of the Wing Commander executables: one line per variable
 *  or array the multiplayer layer reads or writes,
 *
 *      WC_DS(name, offset in WC.EXE, offset in WC2.EXE)
 *
 *  with 0 where a game has no such thing or it has not been located yet
 *  (ds::known()).  WC.EXE names follow the IDA database where it had one;
 *  names in [brackets] are ours, chosen from the code that uses the array.
 *  Look an offset up with scripts/wcexe.py refs dseg:XXXX.
 */
WC_DS(missionStatus, 0x00AE, 0x00B0)  // 0=flying, 1=landed, 2=ejected, 3=carrier, 4=dead, 5=exit
WC_DS(playerCanBeDamaged, 0x00BA, 0x00C0)  // [missionStatus+C]: do_damage ignores slot 0 while zero
WC_DS(aLoadingWingCom, 0x0187, 0x9FC0)  // string buffer we reuse as scratch code/data
WC_DS(aSorryAnErrorHasOccured, 0x0395, 0x0380)  // 249 byte string buffer we reuse for shellcode
WC_DS(skipRecRoom, 0x3004, 0x0000)  // word: nonzero sends runHangarMission straight to the barracks
WC_DS(savedGameLoaded, 0x300C, 0x0000)  // has_loaded_game
WC_DS(randomSeed, 0x7728, 0xA904)  // state of the lo..hi random generator (WC.EXE seg034:0006); the game has two more
WC_DS(commGlobalTxt, 0x8DF8, 0x0000)  // 80 bytes shown by the VDU comm display
WC_DS(pilotLastName, 0x9A42, 0x0000)  // 14 bytes
WC_DS(pilotCallsign, 0x9A50, 0x0000)  // 14 bytes
WC_DS(shownNames, 0, 0x9640)              // WC2: the names its conversations print: callsign, last name at +0x18, first name at +0x30 ("CALLSIGN", "PCNAME", "FIRSTNAME" until a pilot is entered)
WC_DS(savedNames, 0, 0x4629)              // WC2: the same in the saved record: first name, last name at +0x19, callsign at +0x32
WC_DS(gPositionVector, 0xA9C2, 0x56FE)  // 3 x int32 per slot
WC_DS(entityCullStatus, 0xACC4, 0x4768)  // word per slot: screen x of the last frame's drawing (0x8001 = culled/inactive)
WC_DS(entityScreenY, 0xAD44, 0x47F4)  // [entityScreenY] word per slot: its screen y
WC_DS(gOrientationRightVector, 0xAEB6, 0x4D26)  // 3 x int32 per slot
WC_DS(gOrientationUpVector, 0xB1B6, 0x506E)  // named "up", but it points to the bottom of the screen
// (the carrier moves along it when the nose comes up)
WC_DS(gOrientationFrontVector, 0xB4B6, 0x53B6)
WC_DS(setSpeed, 0xB9F6, 0x5FBE)  // [gOrientationFrontVector+540] int32 per slot
WC_DS(damageProperty, 0xBB8E, 0x5D8E)  // word per slot: bolt damage / AI timers
WC_DS(gunDamage, 0xBD0E, 0x67AC)  // [damageProperty+180] byte per slot, 0..5
WC_DS(maybeEntityType, 0xBD1A, 0x64AA)  // word per slot, EntityType
WC_DS(gunEnergy, 0xBE3A, 0x66F8)  // [maybeEntityType+120] word per slot, recharges to 100
WC_DS(speedLo, 0xBE6C, 0x677A)  // [maybeEntityType+152] int32 per slot (lo/hi words)
WC_DS(commAnimInfo, 0xBE94, 0x672A)  // word per slot (1 = has a pilot that talks)
WC_DS(engineFlag, 0xBFD6, 0x67B6)  // [commAnimInfo+142] byte per slot, 0xff = disabled
WC_DS(gInstanceShipTypes, 0xBFF8, 0x641E)  // word per slot, index into kShipStats (0x6f bytes each)
WC_DS(frameCounter, 0xC0B8, 0x43C3)  // [gInstanceShipTypes+C0] incremented once per game frame
WC_DS(damagePoints, 0xC17A, 0x6306)  // [currentNavPoint+2] word per slot, accumulated hull damage
WC_DS(currentNavPoint, 0xC178, 0x441C)  // word: the nav point the player is at (ovr145:098F sets it up)
WC_DS(currentMission, 0xC255, 0x4681)  // byte (WC2: a word, mission 0.. within the series)
WC_DS(currentSeries, 0xC256, 0x467F)  // byte (WC2: a word)
WC_DS(statusPilots, 0xC260, 0x0000)  // word per named pilot (8): 0 = alive, else series * 4 + mission of his death
WC_DS(victoryPoints, 0xC280, 0x0000)  // word
WC_DS(campaignTable, 0x9A88, 0x0000)  // near pointer: 0x5A bytes per series (series 1 first): +2 missions, +3 points for the winning path; +0xA 0x14 bytes per mission, 16 objective point bytes at its +4
WC_DS(missileTarget, 0xC284, 0x6FF4)  // [currentCampaign+2] byte per slot
WC_DS(parentShipForShip, 0xC30E, 0x6392)  // byte per slot, 0xff = none
WC_DS(gMaybeShipRadius, 0xC3B0, 0x627A)  // word per slot
WC_DS(curShield, 0xC430, 0x6680)  // curShieldMaybe: word[2] per slot (front, rear)
WC_DS(gShipBoltList, 0xC472, 0x67D4)  // 0x33 bytes per slot: count + 10 x 5-byte gun entries
WC_DS(tempVector, 0xC6B2, 0x0000)  // scratch vector used by the game
WC_DS(armorState, 0xC85E, 0x66A8)  // armorStateArray: word[4] per slot (front, rear, left, right)
WC_DS(coreHp, 0xC8B8, 0x6E82)  // [armorStateArray+5A] byte per slot, starts at 4
WC_DS(shieldMax, 0xC988, 0x6658)  // shieldMaxMaybe: word[2] per slot
WC_DS(shipAiState, 0xCA56, 0x6752)  // [comm6to5+E] word per slot, 9 = dying, 8 = ?, 0xffff
WC_DS(gVelocityVector, 0xCAE2, 0x5A46)  // 3 x int32 per slot
WC_DS(shipStateByte, 0xD1A2, 0x6E8C)  // [vduModeMaybe+2] byte per slot: pilot set, 8 = Confed pilot
// (player and wingman), 0xff = none; the comms code picks
// the face and name from it (ovr138:0980, ovr140:0020)
WC_DS(hullCounter, 0xD22C, 0x67C0)  // [vduModeMaybe+8C] byte per slot
WC_DS(vduStatus10WhenPlayerHitsSmth, 0xD236, 0x6E96)
WC_DS(systemDamage, 0xD24C, 0x468D)  // [systemDamage] byte per system (9): the player's damage levels, 0..4 (ovr134:0DEC)
WC_DS(cockpitDamage, 0x8CB2, 0xB18E)  // [cockpitDamage] word per cockpit instrument (4): 1 = broken (ovr134:325E)
WC_DS(navPointState, 0xD25D, 0x44F2)  // 8 x 19 bytes: mission tree progress
WC_DS(navPointTable, 0x687C, 0x71DC)  // [navPoints] 0x4d bytes per nav point; its mission ships are ten words at +0x39
WC_DS(playerMissionShip, 0x9560, 0xC1B4)  // [playerMissionShip] word: which mission ship the player flies
WC_DS(cloakState, 0, 0x70A8)              // WC2: [cloakState + 2*slot] word: 2 no cloaking device, 1 cloaked, 0 visible
WC_DS(gunTable, 0xC472, 0x67D4)           // per slot: a count, then a record per gun, type word first (WC1 0x33 bytes, 5 a gun; WC2 0xA1, 10 a gun, 0x0B is a turret)
WC_DS(cockpitView, 0, 0x0B24)             // WC2: byte, the view F1..F4 chose (0 pilot's; in a turret ship 2 left, 1 right, 3 rear)
WC_DS(viewKeyState, 0, 0x00DC)            // WC2: word the F-key handlers clear before they switch the view
WC_DS(cameraMode, 0, 0x9389)              // WC2: word, 4 while the player sits in a turret
WC_DS(viewRect, 0xA816, 0xBD38)           // four words, the 3D view's left, top, right, bottom on the 320x200 screen: the cockpit's window (WC1: 0,0,319,104 in a Hornet, ..111 Scimitar, ..86 Raptor, ..69 Rapier; WC2: ..135 Ferret, ..115 Broadsword)
WC_DS(mouseShift, 0, 0xA337)              // WC2: byte, how far the mouse driver's x is shifted down to a screen x (1; WC1 has the 1 in its code)
WC_DS(steerStepsX, 0x00D1, 0x00EE)        // words, the pointer's distance from the view's middle at which each step of the turn begins (10, 37, 52, 57, 62; then one no pointer reaches)
WC_DS(steerStepsY, 0x00DD, 0x00FA)        // the same up and down (5, 18, 27, 35, 38)
WC_DS(steerInput, 0xC3AA, 0x440E)         // two words, the turn asked for: pitch (down positive), then yaw; -9..9 from the keys, the mouse's steps are 1..5 and 8 at the view's edge
WC_DS(mannedTurret, 0, 0xCD6A)            // WC2: word, which turret that is
WC_DS(turretBarrels, 0, 0xCDA8)           // WC2: word, the barrel offsets of that turret (0 rear, 1 side)
WC_DS(turretEnergy, 0, 0xCD5C)            // WC2: word, the turret guns' energy (100 full, 24 a shot)
WC_DS(turretCooldown, 0, 0x9022)          // WC2: word, frames until the turret fires again
WC_DS(campaignState, 0, 0xCF3A)           // WC2: far pointer to the campaign record (+4 series, +6 mission: what the briefing and the flight load)
WC_DS(playerWing, 0, 0xC1B6)              // WC2: eight words, the mission ships that fly in the player's wing (0xffff: none)
WC_DS(slotMissionShip, 0, 0x6E1E)         // WC2: [slotMissionShip + 2*slot] word: the mission ship in a slot
WC_DS(missionShipTable, 0x6E80, 0x75CE)  // [missionShips] 0x2a bytes per mission ship, word 0 = ship type
WC_DS(fieldRockTally, 0x39A4, 0x8FB2)  // [fieldRockTally] word: rocks added minus rocks dropped (not an exact count)
WC_DS(fieldCount, 0xBFF6, 0x4427)  // [fieldCount] word: fields of the current nav point (max 7)
WC_DS(currentField, 0xC362, 0x44C9)  // [currentField] word: offset of the field the player is in, 0 = none
WC_DS(fieldTable, 0xCDF6, 0x4429)  // [fieldTable] 0x14 bytes per field: type, position, radius
WC_DS(entitiesToDespawn, 0x6610, 0x44CD)  // 0x14 bytes: the slots of the current field's rocks or mines (0xff = free)
WC_DS(entitiesToDespawnTargetA, 0x6626, 0x0000)
WC_DS(playerTarget, 0x662C, 0x468B)  // [entitiesToDespawn+1C]
WC_DS(unknown07A6, 0x07A6, 0x441A)
